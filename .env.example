# ---------------------------------------------------------------------------
# Birlikte İzle — Ortam Değişkenleri
# ---------------------------------------------------------------------------
# Bu dosyayı `.env.local` olarak kopyalayıp değerleri doldur.
# `.env.local` git tarafından takip edilmez.
# ---------------------------------------------------------------------------

# Sunucu portu (arayüz + API + SSE aynı porttan servis edilir)
NOTIFY_PORT=8787

# Dinlenecek adres. 0.0.0.0 aynı ağdaki cihazların bağlanmasını sağlar.
NOTIFY_HOST=0.0.0.0

# Eski odaların durum dosyasından temizlenmesi (gün)
ROOM_TTL_DAYS=30

# --- Arayüz ----------------------------------------------------------------
# Arayüz ayrı bir alan adında yayınlanacaksa API sunucusunun tam adresi.
# Geliştirmede boş bırakılır (Vite /api isteklerini 8787'ye yönlendirir).
# VITE_API_BASE=

# --- Ekran paylaşımı (WebRTC) ----------------------------------------------
# Ekran paylaşımı iki tarayıcı arasında doğrudan kurulur. Aynı ağdaysanız
# ücretsiz STUN sunucuları yeterlidir. Kısıtlı ağlarda (simetrik NAT, kurumsal
# güvenlik duvarı) bir TURN sunucusu gerekir.
#
# DİKKAT: VITE_ önekli değerler tarayıcıya gönderilir. Gerçek TURN parolanızı
# buraya yazmak zorunda kalırsanız, kısa ömürlü (geçici) kimlik bilgisi üreten
# bir TURN yapılandırması kullanın.
# VITE_TURN_URL=turn:turn.ornek.com:3478
# VITE_TURN_USERNAME=kullanici
# VITE_TURN_CREDENTIAL=parola
