{
  "name": "birlikte-izle",
  "private": true,
  "version": "1.0.0",
  "description": "İki kişinin gerçek zamanlı olarak birlikte video izleyebildiği senkronize izleme ve sohbet platformu.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:all": "node server/dev-all.mjs",
    "server": "node server/index.mjs",
    "start": "node server/index.mjs",
    "serve": "npm run build && node server/index.mjs",
    "build": "tsc -b && vite build",
    "build:p2p": "tsc -b && vite build --mode p2p",
    "preview": "vite preview",
    "preview:p2p": "vite preview --mode p2p",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.17",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@vimeo/player": "^2.30.4",
    "clsx": "^2.1.1",
    "hls.js": "^1.7.4",
    "lucide-react": "^1.73.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "tailwind-merge": "^3.7.0",
    "trystero": "^0.27.0"
  }
}
